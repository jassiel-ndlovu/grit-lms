// assessments.prisma — owned by Agent B (docs/revamp/AGENTS.md, section 2).
// Part of the multi-file schema in prisma/schema/. Edit only the files your agent owns.

model Test {
  id                        String                 @id @default(cuid())
  title                     String
  courseId                  String
  dueDate                   DateTime
  createdAt                 DateTime               @default(now())
  description               String
  isActive                  Boolean                @default(true)
  preTestInstructions       String?
  timeLimit                 Int?
  totalPoints               Int
  // When true, the auto-marker runs at submit time AND the resulting
  // grade is visible to the student immediately. When false the tutor
  // still gets an auto-grade suggestion in the grading UI, but the
  // student sees no grade until the tutor releases it.
  releaseAutoMarksToStudent Boolean                @default(false)
  /// AI-assisted marking suggestions for written answers (A, #150). Off by default; the tutor turns it on per test. Suggestions never release on their own.
  aiMarking                 Boolean                @default(false)
  // Share of the course's final mark, as a percentage (e.g. 30 = 30%).
  // null means "no explicit weight" and the gradebook falls back to
  // weighting this assessment by its totalPoints relative to the other
  // unweighted assessments. See features/grades/lib/weighting.ts.
  weight                    Float?
  // Optional memo / worked-solutions documents for the whole test,
  // uploaded by the tutor at authoring time. Students see them on the
  // review page once their attempt has been graded.
  memoFileUrls              String[]               @default([])
  // enumitem-style label template per question nesting level. Empty =
  // the default 1 / 1.a / 1.a.1 scheme. See src/lib/enum-labels.ts.
  labelScheme               String[]               @default([])
  AssessmentCompletion      AssessmentCompletion[]
  course                    Course                 @relation(fields: [courseId], references: [id])
  questions                 TestQuestion[]
  submissions               TestSubmission[]
}

model TestQuestion {
  id           String       @id @default(uuid())
  testId       String
  parentId     String?
  order        Int?
  question     String
  type         QuestionType
  points       Int
  options      String[]
  answer       Json?
  language     String?
  matchPairs   Json?
  reorderItems String[]
  blankCount   Int?
  /// For AI-assisted marking: { criteria: [{ id, label, max }], notes? }. Without it, the question's points are one criterion.
  rubric       Json?
  /// How a maths answer is marked. Null keeps exact matching; MATH_EXPRESSION defaults to EQUIVALENT in code (B design 01-maths-in-answers).
  mathMode     MathMode?
  /// Curriculum topic codes, e.g. "caps:mathematics:10:functions" (contracts/curriculum.md).
  topics       String[]     @default([])
  createdAt    DateTime     @default(now())

  // Relations
  test         Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  UploadedFile UploadedFile[]

  // Self-relation for sub-questions
  parent       TestQuestion?  @relation("SubQuestions", fields: [parentId], references: [id], onDelete: Cascade)
  subQuestions TestQuestion[] @relation("SubQuestions")
}

model TestSubmission {
  id               String             @id @default(cuid())
  testId           String
  studentId        String
  startedAt        DateTime
  submittedAt      DateTime?
  answers          Json
  score            Float?
  feedback         String?
  status           SubmissionStatus
  // The student's TimeAccommodation for the course, copied when the
  // attempt starts (and updated if a tutor changes it mid-sitting). Read by
  // lib/attempt-deadline.ts: the runner's clock and the auto-submit job.
  extraTimePercent Int                @default(0)
  noTimeLimit      Boolean            @default(false)
  grade            Grade?
  questionGrades   QuestionGrade[]
  aiSuggestions    AiMarkSuggestion[]
  student          Student            @relation(fields: [studentId], references: [id])
  test             Test               @relation(fields: [testId], references: [id], onDelete: Cascade)
  uploadedFiles    UploadedFile[]
}

/// EQUIVALENT: mathematically equal. FORM: equal and in the asked form. MARGIN: numerically within a margin.
enum MathMode {
  EQUIVALENT
  FORM
  MARGIN
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  FILE_UPLOAD
  MULTI_SELECT
  CODE
  MATCHING
  REORDER
  FILL_IN_THE_BLANK
  NUMERIC
  /// A maths answer, typed in a maths field; answers and keys are TeX in the existing JSON (B design 01-maths-in-answers).
  MATH_EXPRESSION
  // Context-only — parent questions that group sub-questions but aren't
  // themselves answerable. Tutor authoring should reject NONE for any
  // question without subQuestions.
  NONE
}

/// Extra time one student gets on a course's timed tests (owner decision 7,
/// WCAG 2.2.1 Timing Adjustable). Set by the course's tutor on the course
/// Settings page; copied onto each TestSubmission when it starts. The due
/// date still closes the test. studentId has no relation because Student
/// lives in core.prisma (Agent A's); rows go with the course.
model TimeAccommodation {
  id               String   @id @default(cuid())
  courseId         String
  studentId        String
  /// 0, 25, 50 or 100: the time limit grows by this share.
  extraTimePercent Int      @default(0)
  /// The student's timed tests on this course have no time limit.
  noTimeLimit      Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  updatedByUserId  String?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId])
}

model AssessmentCompletion {
  id          String    @id @default(cuid())
  studentId   String
  quizId      String?
  testId      String?
  startedAt   DateTime
  completedAt DateTime?
  score       Float?
  quiz        Quiz?     @relation(fields: [quizId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  test        Test?     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Submission {
  id               String            @id @default(cuid())
  title            String
  courseId         String
  dueDate          DateTime
  createdAt        DateTime
  fileType         String
  maxAttempts      Int?
  lastDueDate      DateTime?
  description      String
  /// Rich-text brief: {schemaVersion, doc} from src/lib/content. `description`
  /// keeps the markdown derived from it.
  descriptionJson  Json?
  descriptionFiles String[]
  // Optional memo/solutions files a tutor can release after grading —
  // separate from `descriptionFiles`, which are the brief given up-front.
  // Students only see these once they've been added.
  memoFileUrls     String[]          @default([])
  totalPoints      Int               @default(1)
  // Percentage share of the course's final mark; null = weight by points.
  // Mirrors Test.weight - see features/grades/lib/weighting.ts.
  weight           Float?
  isActive         Boolean?          @default(true)
  course           Course            @relation(fields: [courseId], references: [id])
  entries          SubmissionEntry[]
}

model SubmissionEntry {
  id             String           @id @default(cuid())
  studentId      String
  submissionId   String
  submittedAt    DateTime
  attemptNumber  Int
  status         SubmissionStatus
  feedback       String
  fileUrl        String[]
  grade          Grade?
  questionGrades QuestionGrade[]
  student        Student          @relation(fields: [studentId], references: [id])
  submission     Submission       @relation(fields: [submissionId], references: [id])

  @@unique([submissionId, studentId])
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  LATE
  IN_PROGRESS
  NOT_SUBMITTED
  NOT_STARTED
}

model QuestionGrade {
  id                String           @id @default(cuid())
  questionId        String?
  score             Float
  outOf             Float
  feedback          String?
  /// Marks per rubric criterion, `{ [criterionId]: marks }`, only when they add up to `score` (#216).
  criteria          Json?
  testSubmissionId  String?
  submissionEntryId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  submissionEntry   SubmissionEntry? @relation(fields: [submissionEntryId], references: [id], onDelete: Cascade)
  testSubmission    TestSubmission?  @relation(fields: [testSubmissionId], references: [id], onDelete: Cascade)
}

model Grade {
  id                String           @id @default(cuid())
  studentId         String
  courseId          String
  type              String
  title             String
  outOf             Float
  createdAt         DateTime         @default(now())
  finalComments     String?
  submissionEntryId String?          @unique
  testSubmissionId  String?          @unique
  updatedAt         DateTime         @updatedAt
  score             Float
  course            Course           @relation(fields: [courseId], references: [id])
  student           Student          @relation(fields: [studentId], references: [id])
  submissionEntry   SubmissionEntry? @relation(fields: [submissionEntryId], references: [id], onDelete: Cascade)
  testSubmission    TestSubmission?  @relation(fields: [testSubmissionId], references: [id], onDelete: Cascade)
}

enum AiMarkStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  SKIPPED
}

enum AiConfidence {
  HIGH
  MEDIUM
  LOW
}

enum AiTutorAction {
  ACCEPTED
  EDITED
  REJECTED
}

/// An AI-suggested mark for one question of one submission (A, #150; B research 09). A suggestion only: the tutor accepts, edits or rejects it, and nothing reaches the student until the tutor releases marks. Deleted with the submission. Holds no prompt text; `requestId` is the opaque id sent to the provider.
model AiMarkSuggestion {
  id                String         @id @default(cuid())
  testSubmissionId  String
  questionId        String
  workspaceId       String?
  requestId         String         @unique
  status            AiMarkStatus   @default(QUEUED)
  attempts          Int            @default(0)
  model             String?
  promptVersion     String?
  /// [{ id, label, awarded, max, justification, evidence[] }]
  criteria          Json?
  totalAwarded      Float?
  outOf             Float
  confidence        AiConfidence?
  flags             String[]       @default([])
  feedbackToStudent String?
  escalated         Boolean        @default(false)
  inputTokens       Int            @default(0)
  outputTokens      Int            @default(0)
  cacheReadTokens   Int            @default(0)
  /// Provider cost in millionths of a US dollar.
  costMicroUsd      Int            @default(0)
  error             String?
  tutorAction       AiTutorAction?
  tutorScore        Float?
  actedByUserId     String?
  actedAt           DateTime?
  requestedByUserId String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  testSubmission TestSubmission @relation(fields: [testSubmissionId], references: [id], onDelete: Cascade)

  @@unique([testSubmissionId, questionId])
  @@index([status, createdAt])
  @@index([questionId])
}
