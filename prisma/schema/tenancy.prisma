// tenancy.prisma — owned by Agent A (docs/revamp/AGENTS.md, section 2).
// Part of the multi-file schema in prisma/schema/. Edit only the files your agent owns.
//
// Design: docs/revamp/a/design/01-tenancy-roles.md. Part 1 (4_tenancy_core):
// workspaces, members, learners, guardians, audit log. Part 2
// (6_tenancy_courses): Enrollment, CourseStaff, and the tenancy columns on
// Course in learning.prisma.

/// The meeting service a workspace's session form suggests (#211). Google Meet unless an owner or admin changes it.
enum MeetingProvider {
  GOOGLE_MEET
  ZOOM
  TEAMS
  OTHER
}

enum WorkspaceKind {
  ORGANISATION
  SOLO
}

enum BillingState {
  TRIAL
  ACTIVE
  PAST_DUE
  READ_ONLY
  COMPED
  CANCELLED
}

enum MembershipRole {
  OWNER
  ADMIN
  TUTOR
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum LearnerStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum CourseStaffRole {
  LEAD
  ASSISTANT
}

enum GuardianRelationship {
  PARENT
  GUARDIAN
  OTHER
}

enum GuardianshipStatus {
  PENDING
  ACTIVE
  REVOKED
}

/// The tenant: an organisation with tutor teams, or a solo practice.
model Workspace {
  id                String          @id @default(cuid())
  kind              WorkspaceKind
  name              String
  slug              String          @unique
  timezone          String          @default("Africa/Johannesburg")
  logoUrl           String?
  accentColor       String?
  billingState      BillingState    @default(TRIAL)
  trialEndsAt       DateTime?
  /// Set when an organisation switched teaching off (owner decision 2026-11-21): its owners and admins no longer teach, and it has no tutor mode. Only a Nexa admin clears it. Null means it may teach.
  teachingOffAt     DateTime?
  teachingOffById   String?
  meetingProvider   MeetingProvider @default(GOOGLE_MEET)
  /// Whether tutors may add their own AI credits once the organisation's run out (#216). Management decides.
  aiPersonalCredits Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  teams              Team[]
  memberships        Membership[]
  learners           Learner[]
  auditLogs          AuditLog[]
  courses            Course[]
  enrollments        Enrollment[]
  courseListings     CourseListing[]
  importJobs         ImportJob[]
  referralCodes      ReferralCode[]
  branches           Branch[]
  roles              WorkspaceRole[]
  aiCreditEntries    AiCreditEntry[]
  aiCreditAllowances AiCreditAllowance[]
  referrals          Referral[]
  managedUsers       User[]              @relation("ManagedUsers")
  joinRequests       JoinRequest[]
  reportTerms        ReportTerm[]

  // Billing and payments (billing.prisma, Phase 2).
  subscription        Subscription?
  invites             Invite[]
  billingPeriods      BillingPeriod[]
  courseServices      CourseService[]
  courseTierHolds     CourseTierHold[]
  courseTierOverrides CourseTierOverride[]
  usageRecords        UsageRecord[]
  usageCaps           UsageCap[]
  platformInvoices    PlatformInvoice[]
  creditNotes         CreditNote[]
  paymentSettings     PaymentSettings?
  payoutAccounts      PayoutAccount[]
  feeSchedules        FeeSchedule[]
  feeInvoices         Invoice[]
  offsitePayments     OffsitePayment[]
  riskAlerts          RiskAlert[]
  bookingAvailability BookingAvailability[]
  bookingTimeOff      BookingTimeOff[]
  bookings            Booking[]
  lessonCredits       LessonCredit[]
  /// Session booking (#216): cancel at least this many hours before for the lesson credit back.
  bookingCancelHours  Int                   @default(24)
  /// Book at least this many hours ahead.
  bookingLeadHours    Int                   @default(12)
  /// And at most this many days ahead.
  bookingHorizonDays  Int                   @default(28)
  aiAssistRuns        AiAssistRun[]
  apiKeys             ApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  timesheets          Timesheet[]
  payRates            PayRate[]
  coverRequests       CoverRequest[]
}

/// Organisations only. A solo practice has no teams.
model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  /// The branch this team belongs to (#216): a company has branches, a branch has teams.
  branchId    String?
  createdAt   DateTime @default(now())

  branch    Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  courses   Course[]

  @@index([workspaceId])
}

/// Staff in a workspace. Created ACTIVE when an invite is accepted
/// (pending invites live in Invite, design 02).
model Membership {
  id           String           @id @default(cuid())
  workspaceId  String
  userId       String
  role         MembershipRole
  status       MembershipStatus @default(ACTIVE)
  /// A built-in role beyond the three base ones (#216), for example EXECUTIVE or FINANCE. Null: the base role's own preset.
  presetRole   String?
  /// An organisation's own role, made from a preset. Wins over presetRole.
  customRoleId String?
  /// For a role limited to branches: which ones. Empty for every other scope.
  branchIds    String[]         @default([])
  invitedById  String?
  joinedAt     DateTime         @default(now())

  customRole   WorkspaceRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams        TeamMember[]
  courseStaff  CourseStaff[]
  ownedCourses Course[]       @relation("CourseOwner")

  bookingAvailability BookingAvailability[]
  bookingTimeOff      BookingTimeOff[]
  bookings            Booking[]

  timesheets Timesheet[]
  payRate    PayRate?

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TeamMember {
  teamId       String
  membershipId String
  isLead       Boolean @default(false)

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([teamId, membershipId])
  @@index([membershipId])
}

/// A student's place in one workspace. Enrollments (per course) follow in part 2.
model Learner {
  id                String        @id @default(cuid())
  workspaceId       String
  userId            String
  status            LearnerStatus @default(ACTIVE)
  /// Adult students may see and pay their own fees. Never true for a minor.
  paymentVisible    Boolean       @default(false)
  isMinor           Boolean       @default(true)
  /// v1: the tutor attests they hold a parent's consent (design 02).
  consentAttestedAt DateTime?
  consentAttestedBy String?
  createdAt         DateTime      @default(now())

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  feeSchedules FeeSchedule[]
  attendance   SessionAttendance[]

  reportComments        ReportCourseComment[]
  reportOverallComments ReportOverallComment[]

  bookings      Booking[]
  lessonCredits LessonCredit[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// A learner on one course. Append-only intervals (design 01): dropping sets
/// endedAt, re-enrolling adds a row and never moves startedAt. Billing counts
/// a learner as active in a period if any interval overlaps it. At most one
/// open row (endedAt null) per course and learner, enforced in the data layer.
model Enrollment {
  id          String           @id @default(cuid())
  workspaceId String
  courseId    String
  learnerId   String
  status      EnrollmentStatus @default(ACTIVE)
  startedAt   DateTime         @default(now())
  endedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learner   Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([courseId, learnerId])
  @@index([learnerId])
  @@index([workspaceId, startedAt])
}

/// Who teaches a course. The owner membership is always LEAD.
model CourseStaff {
  courseId     String
  membershipId String
  role         CourseStaffRole @default(LEAD)

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([courseId, membershipId])
  @@index([membershipId])
}

/// A parent or guardian linked to a student, across workspaces.
/// Guardian invites and in-app consent come after v1 (owner decision).
model Guardianship {
  id             String               @id @default(cuid())
  guardianUserId String
  studentUserId  String
  relationship   GuardianRelationship @default(PARENT)
  status         GuardianshipStatus   @default(PENDING)
  consentAt      DateTime?
  consentVersion String?
  createdAt      DateTime             @default(now())

  guardian User @relation("GuardianshipGuardian", fields: [guardianUserId], references: [id], onDelete: Cascade)
  student  User @relation("GuardianshipStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([guardianUserId, studentUserId])
  @@index([studentUserId])
}

/// Every admin override, impersonation, role change and money action.
model AuditLog {
  id                 String   @id @default(cuid())
  workspaceId        String?
  actorUserId        String
  impersonatorUserId String?
  action             String
  targetType         String
  targetId           String?
  data               Json?
  at                 DateTime @default(now())

  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor        User       @relation("AuditActor", fields: [actorUserId], references: [id])
  impersonator User?      @relation("AuditImpersonator", fields: [impersonatorUserId], references: [id])

  @@index([workspaceId, at])
  @@index([actorUserId, at])
}

enum InviteKind {
  STAFF
  LEARNER
  GUARDIAN
}

/// An emailed invitation (design 02, section 5). v1 uses STAFF only; LEARNER and GUARDIAN fields exist so the later flows need no migration. One pending invite per (workspace, email, kind), enforced by a partial unique index in the migration. Only a hash of the token is stored.
model Invite {
  id               String          @id @default(cuid())
  workspaceId      String
  kind             InviteKind
  /// Lower case.
  email            String
  tokenHash        String          @unique
  /// STAFF only: ADMIN or TUTOR.
  role             MembershipRole?
  /// STAFF: CourseStaff rows to create. LEARNER (later): enrolments.
  courseIds        String[]        @default([])
  isMinor          Boolean         @default(false)
  learnerInviteId  String?
  learnerId        String?
  displayName      String
  invitedById      String
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  createdAt        DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind])
  @@index([email])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// A course students and parents can find and ask to join (#206). No row: the course isn't listed.
model CourseListing {
  courseId    String   @id
  workspaceId String
  listedById  String
  listedAt    DateTime @default(now())

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// A student, or a parent for their child, asking to join a listed course (#206). Staff approve (which adds the Learner and the enrolment) or decline. One PENDING request per course and student, enforced by a partial unique index in the migration.
model JoinRequest {
  id              String            @id @default(cuid())
  workspaceId     String
  courseId        String
  requesterUserId String
  /// The student to enrol: the requester, or their child.
  studentUserId   String
  message         String?
  status          JoinRequestStatus @default(PENDING)
  decidedById     String?
  decidedAt       DateTime?
  declineReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  requester User      @relation("JoinRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  student   User      @relation("JoinRequestStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([courseId, status])
  @@index([requesterUserId, createdAt])
  @@index([studentUserId])
}

enum ImportStatus {
  /// Parsed and checked; waiting for the person to fix rows and confirm.
  PREVIEW
  /// Confirmed; rows are being applied in batches.
  APPLYING
  DONE
  /// Stopped by an error that isn't about one row.
  FAILED
  /// Undo was asked for; rows are being reversed in batches.
  UNDOING
  UNDONE
  CANCELLED
}

/// One import (#216, phase 1): a file read into rows, previewed, fixed, confirmed and applied row by row, with an undo log. The rows live here as JSON until the job is cleared (30 days). Contract: docs/revamp/contracts/imports.md.
model ImportJob {
  id              String       @id @default(cuid())
  workspaceId     String
  /// The importer's key, for example "students" or "staff".
  kind            String
  status          ImportStatus @default(PREVIEW)
  fileName        String
  createdById     String
  rowCount        Int          @default(0)
  /// Every row: { n, data, action, issues, outcome?, undo? }.
  rows            Json
  /// Choices made at confirm time, for example { consentAttested: true }.
  options         Json?
  /// Counts by outcome, filled while applying.
  summary         Json?
  /// The next row to apply.
  cursor          Int          @default(0)
  /// Whoever holds this may apply rows until then.
  leaseUntil      DateTime?
  /// Sign-in codes made by the import, sealed, for the printable cards. Removed when they expire.
  secretsSealed   String?
  secretsExpireAt DateTime?
  error           String?
  createdAt       DateTime     @default(now())
  confirmedAt     DateTime?
  finishedAt      DateTime?
  /// Undo is offered until then (24 hours after finishing).
  undoUntil       DateTime?
  undoneAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, leaseUntil])
}

enum ReferralStatus {
  /// The referred family asked to join a course.
  REQUESTED
  /// Staff approved, so the referred student is in the workspace.
  JOINED
}

/// A parent's or student's personal link into a workspace (Core, owner decision 22 Nov; #216). One per person per workspace.
model ReferralCode {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  /// Short and unguessable; the link is /api/referrals/<code>.
  code        String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@unique([workspaceId, userId])
}

/// A family that came through someone's link and asked to join. Rewards aren't decided yet; this records who referred whom.
model Referral {
  id             String         @id @default(cuid())
  workspaceId    String
  codeId         String
  referrerUserId String
  /// The student who asked to join (or whose parent asked).
  referredUserId String
  joinRequestId  String?        @unique
  status         ReferralStatus @default(REQUESTED)
  createdAt      DateTime       @default(now())
  joinedAt       DateTime?

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code      ReferralCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrer  User         @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred  User         @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Cascade)

  /// A student is credited to one referrer per workspace: the first.
  @@unique([workspaceId, referredUserId])
  @@index([referrerUserId])
}

/// Where a role applies (#216): the whole workspace, some branches, or the courses the person teaches or owns.
enum RoleScope {
  WORKSPACE
  BRANCHES
  OWN_COURSES
}

/// A branch of an organisation (#216): a centre or campus. Teams sit in a branch; courses reach a branch through their team.
model Branch {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teams     Team[]

  @@unique([workspaceId, name])
}

/// An organisation's own role (#216): a name, a set of permissions and a scope, copied from a preset and adjusted. Never more than an admin holds.
model WorkspaceRole {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  /// The preset it was made from, for display.
  basedOn     String
  /// Used where code still checks the base role (ADMIN or TUTOR, never OWNER).
  baseRole    MembershipRole
  permissions String[]
  scope       RoleScope
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([workspaceId, name])
}

// Session booking (#216 phase 2, Plus; A). Arithmetic: src/features/booking/booking-math.ts.

enum BookingStatus {
  BOOKED
  CANCELLED
  COMPLETED
  NO_SHOW
}

/// A tutor's weekly bookable time, in the workspace's time zone.
model BookingAvailability {
  id            String   @id @default(cuid())
  workspaceId   String
  membershipId  String
  /// Null: any course the tutor teaches.
  courseId      String?
  /// 0 = Sunday … 6 = Saturday.
  weekday       Int
  /// Minutes after local midnight.
  startMinute   Int
  endMinute     Int
  slotMinutes   Int      @default(60)
  bufferMinutes Int      @default(0)
  createdAt     DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId])
  @@index([workspaceId])
}

/// Time a tutor can't be booked (leave, a holiday).
model BookingTimeOff {
  id           String   @id @default(cuid())
  workspaceId  String
  membershipId String
  startsAt     DateTime
  endsAt       DateTime
  note         String?  @db.VarChar(200)
  createdAt    DateTime @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, startsAt])
}

/// One booked lesson: a learner with a tutor, for a course.
model Booking {
  id                String        @id @default(cuid())
  workspaceId       String
  courseId          String
  /// The tutor.
  membershipId      String
  learnerId         String
  startsAt          DateTime
  endsAt            DateTime
  status            BookingStatus @default(BOOKED)
  /// "<membershipId>:<startsAt epoch ms>" while BOOKED, so a tutor can't be double-booked; null otherwise.
  slotKey           String?       @unique
  bookedByUserId    String
  note              String?       @db.VarChar(500)
  meetingLink       String?       @db.VarChar(500)
  /// A lesson credit was used (the course sells lesson packs).
  usedCredit        Boolean       @default(false)
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelReason      String?       @db.VarChar(300)
  creditReturned    Boolean       @default(false)
  remindedAt        DateTime?
  createdAt         DateTime      @default(now())

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, startsAt])
  @@index([membershipId, startsAt])
  @@index([courseId, startsAt])
  @@index([status, startsAt])
}

// API keys and webhooks (#216 phase 3, Pro; A). docs/revamp/contracts/api.md.

/// A workspace's key for the read-only REST API (/api/v1). Only a sha256 of the key is kept; it is shown once.
model ApiKey {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String    @db.VarChar(80)
  /// The first characters, to tell keys apart ("nexa_live_AbC1").
  prefix          String    @db.VarChar(20)
  hash            String    @unique @db.VarChar(64)
  /// e.g. courses.read, learners.read, grades.read, attendance.read, invoices.read, bookings.read
  scopes          String[]
  createdByUserId String
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  revokedAt       DateTime?
  /// Rate limit: requests in the current minute.
  minuteStart     DateTime?
  minuteCount     Int       @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Where a workspace's events are POSTed, signed with the endpoint's secret.
model WebhookEndpoint {
  id              String    @id @default(cuid())
  workspaceId     String
  url             String    @db.VarChar(500)
  description     String?   @db.VarChar(120)
  /// Event names, e.g. invoice.paid, booking.created. Empty means none.
  events          String[]
  /// AES-GCM sealed signing secret (key derived from NEXTAUTH_SECRET).
  secretSealed    String
  secretPrefix    String    @db.VarChar(20)
  active          Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  lastSuccessAt   DateTime?
  /// Set at the first failure in a run of failures; cleared by a success. Three days of failures switch the endpoint off.
  failingSince    DateTime?
  disabledReason  String?   @db.VarChar(200)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

enum WebhookDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// One event for one endpoint. Kept 30 days.
model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  event         String                @db.VarChar(60)
  /// The full JSON body sent (id, type, created, workspace, data).
  payload       Json
  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  lockedUntil   DateTime?
  lastStatus    Int?
  lastError     String?               @db.VarChar(300)
  createdAt     DateTime              @default(now())
  deliveredAt   DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// Tutor timesheets, payroll export and cover (#216 phase 3, organisations; A).

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum TimesheetEntryKind {
  SESSION
  COVER
  BOOKING
  MANUAL
}

/// One tutor's month (YYYY-MM in the workspace's time zone).
model Timesheet {
  id           String          @id @default(cuid())
  workspaceId  String
  membershipId String
  month        String          @db.VarChar(7)
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decisionNote String?         @db.VarChar(500)
  /// Set at approval: the rate and totals that payroll uses.
  hourlyCents  Int?
  totalMinutes Int             @default(0)
  amountCents  Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  entries    TimesheetEntry[]

  @@unique([membershipId, month])
  @@index([workspaceId, month, status])
}

model TimesheetEntry {
  id              String             @id @default(cuid())
  timesheetId     String
  kind            TimesheetEntryKind
  /// For suggested entries: the class occurrence or booking, so it's added once.
  key             String?            @db.VarChar(120)
  courseId        String?
  startsAt        DateTime
  minutes         Int
  label           String             @db.VarChar(200)
  note            String?            @db.VarChar(300)
  eventId         String?
  occurrenceStart DateTime?
  bookingId       String?
  createdAt       DateTime           @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@unique([timesheetId, key])
  @@index([timesheetId, startsAt])
}

/// A tutor's hourly rate, for payroll. Snapshotted onto a timesheet when it's approved.
model PayRate {
  membershipId String   @id
  workspaceId  String
  hourlyCents  Int
  updatedAt    DateTime @updatedAt
  updatedById  String

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum CoverStatus {
  OPEN
  ASSIGNED
  CANCELLED
}

/// A class occurrence whose tutor is away, and who covers it.
model CoverRequest {
  id                 String      @id @default(cuid())
  workspaceId        String
  courseId           String
  eventId            String
  occurrenceStart    DateTime
  startsAt           DateTime
  endsAt             DateTime
  absentMembershipId String
  coverMembershipId  String?
  status             CoverStatus @default(OPEN)
  /// "<eventId>@<occurrenceStart ISO>" while OPEN or ASSIGNED; null once cancelled.
  liveKey            String?     @unique
  reason             String?     @db.VarChar(300)
  createdById        String
  assignedById       String?
  assignedAt         DateTime?
  /// True when assigning added the cover tutor to the course; that access is removed a day after the class.
  addedCourseStaff   Boolean     @default(false)
  accessEndedAt      DateTime?
  createdAt          DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
  @@index([coverMembershipId, startsAt])
  @@index([absentMembershipId, startsAt])
}
