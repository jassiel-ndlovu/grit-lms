// core.prisma — owned by Agent A (docs/revamp/AGENTS.md, section 2).
// Part of the multi-file schema in prisma/schema/. Edit only the files your agent owns.

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used by the app.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection, used only by prisma migrate.
  // See docs/revamp/a/design/06-deployment.md.
  directUrl = env("DIRECT_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  /// bcrypt hash for NextAuth. Better Auth keeps passwords in Account and never writes this, so it defaults to "" (matches no password). Dropped after the cutover.
  password      String       @default("")
  role          Role         @default(STUDENT)
  createdAt     DateTime     @default(now())
  // Set once the user clicks the link in their verification email.
  // Notification emails are only sent to verified addresses.
  emailVerified DateTime?
  // Nexa staff vs everyone else (design 01). What a person is inside a
  // workspace comes from Membership, Learner and Guardianship, not `role`,
  // which stays until the app stops reading it.
  platformRole  PlatformRole @default(USER)

  // Better Auth (design 02; stage 1, not yet used for sign-in). Its
  // emailVerified boolean is mapped to emailConfirmed so the DateTime above
  // keeps working until the cutover.
  emailConfirmed          Boolean   @default(false)
  image                   String?
  updatedAt               DateTime  @default(now()) @updatedAt
  /// Lower case; for tutor-created students who sign in without an email.
  username                String?   @unique
  displayUsername         String?
  twoFactorEnabled        Boolean?  @default(false)
  /// True for a self sign-up (email or Google) until they choose tutor, student or parent on the welcome page (owner decision 2026-11-20). Accounts made by tutors or admins are confirmed.
  roleUnconfirmed         Boolean   @default(false)
  /// Set when a tutor creates the account or issues a new sign-in code: the code is the password until the user chooses their own (design 02, section 5.1).
  mustChangePassword      Boolean   @default(false)
  /// The sign-in code stops working after this, if still unchanged.
  initialCodeExpiresAt    DateTime?
  /// A student without an email gets <id>@students.nexa-lms.invalid; nothing is ever sent to it.
  emailIsPlaceholder      Boolean   @default(false)
  /// Account deletion (design 02, section 8): requested, then anonymised by the daily job once the 14-day grace ends. Sign-in is blocked meanwhile; the emailed link cancels it.
  deletionRequestedAt     DateTime?
  deletionCancelTokenHash String?   @unique
  /// Set when the account was anonymised.
  deletedAt               DateTime?

  preferences             UserPreferences?
  activities              ActivityLog[]
  notifications           Notification[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Tenancy (tenancy.prisma)
  memberships        Membership[]
  learners           Learner[]
  guardianOf         Guardianship[] @relation("GuardianshipGuardian")
  guardedBy          Guardianship[] @relation("GuardianshipStudent")
  auditActions       AuditLog[]     @relation("AuditActor")
  auditImpersonating AuditLog[]     @relation("AuditImpersonator")
  tutorProfile       Tutor?
  studentProfile     Student?

  authSessions      Session[]
  authAccounts      Account[]
  twoFactors        TwoFactor[]
  calendarFeedToken CalendarFeedToken?
  invitesSent       Invite[]             @relation("InviteInvitedBy")
  emailChanges      EmailChangeRequest[]
}

enum PlatformRole {
  USER
  NEXA_ADMIN
}

// One-time email verification links. Only a SHA-256 hash of the token is
// stored; the raw token lives in the emailed link.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPreferences {
  id                      String                @id @default(cuid())
  userId                  String                @unique
  emailNotifications      Boolean               @default(true)
  pushNotifications       Boolean               @default(true)
  notificationFrequency   NotificationFrequency @default(IMMEDIATE)
  notifyOnCourseUpdate    Boolean               @default(true)
  notifyOnNewLesson       Boolean               @default(true)
  notifyOnNewTest         Boolean               @default(true)
  notifyOnDueDateReminder Boolean               @default(true)
  notifyOnGrades          Boolean               @default(true)
  notifyOnMessages        Boolean               @default(true)
  darkMode                Boolean               @default(false)
  preferredLanguage       String                @default("EN")
  timeZone                String?
  preferredView           PreferredView         @default(GRID)
  studyReminders          Boolean               @default(false)
  defaultDashboardTab     DashboardTab          @default(COURSES)
  // Tutor-only alerts.
  notifyOnSubmissions     Boolean               @default(true)
  notifyOnGradingQueue    Boolean               @default(true)
  // When the last DAILY/WEEKLY email digest went out.
  lastDigestSentAt        DateTime?

  user User @relation(fields: [userId], references: [id])
}

model Tutor {
  id              String  @id @default(cuid())
  fullName        String
  email           String  @unique
  profileImageUrl String?
  bio             String?
  // Replaces matching on email (design 01, section 8). Backfilled by
  // scripts/backfill-tenancy.ts; required once every row has one.
  userId          String? @unique
  user            User?   @relation(fields: [userId], references: [id])
}

model Student {
  id                    String                 @id @default(cuid())
  fullName              String
  email                 String                 @unique
  imageUrl              String?
  assessmentCompletions AssessmentCompletion[]
  Grade                 Grade[]
  lessonCompletions     LessonCompletion[]
  Notification          Notification[]
  submissionEntries     SubmissionEntry[]
  TestSubmission        TestSubmission[]
  // Replaces matching on email (design 01, section 8). Backfilled by
  // scripts/backfill-tenancy.ts; required once every row has one.
  userId                String?                @unique
  user                  User?                  @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  action    ActivityType
  targetId  String?
  meta      Json?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
  PARENT
}

enum ActivityType {
  LESSON_COMPLETED
  TEST_COMPLETED
  ASSIGNMENT_SUBMITTED
  GRADE_RECEIVED
  MESSAGE_SENT
  MESSAGE_RECEIVED
  LOGIN
  LOGOUT
}

enum NotificationFrequency {
  IMMEDIATE
  DAILY
  WEEKLY
  NONE
}

enum PreferredView {
  LIST
  GRID
  TIMELINE
}

enum DashboardTab {
  COURSES
  NOTIFICATIONS
  CALENDAR
  GRADES
}

// One row per scheduled-job run (src/lib/jobs/define.ts). Read by
// /api/health to alert when a job stops. Counts only, never personal data.
// Pruned after 30 days by the housekeeping job.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  trigger    String // "bearer" (GitHub Actions, Vercel Cron, manual) or "qstash"
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  result     Json?
  error      String?

  @@index([job, startedAt])
}

/// One-time password reset links (src/features/auth/password-reset.ts).
/// Only a SHA-256 of the token is stored; the link expires after an hour.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * -------------------------------------------------------------------------
 * Better Auth tables (design 02, section 2). Stage 1: created and backfilled
 * alongside NextAuth; sign-in moves to them at the cutover.
 * -------------------------------------------------------------------------
 */

/// A signed-in device. Database sessions, so they can be revoked.
model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  /// Set by the admin plugin while a Nexa admin impersonates (later).
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way to sign in. providerId "credential" holds the password hash (bcrypt carried over from User.password, scrypt after the next sign-in).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
}

/// Better Auth's rate limiter (storage "database", since serverless has no shared memory).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

/// A change of email address (design 02, section 8). The confirm link goes to the new address (1 hour); once confirmed, the old address gets a link that undoes it (7 days). Only hashes of the tokens are stored.
model EmailChangeRequest {
  id               String    @id @default(cuid())
  userId           String
  oldEmail         String
  newEmail         String
  confirmTokenHash String    @unique
  expiresAt        DateTime
  confirmedAt      DateTime?
  revertTokenHash  String?   @unique
  revertExpiresAt  DateTime?
  revertedAt       DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
