// learning.prisma — owned by Agent B (docs/revamp/AGENTS.md, section 2).
// Part of the multi-file schema in prisma/schema/. Edit only the files your agent owns.

model Course {
  id                 String              @id @default(cuid())
  name               String
  description        String?
  imageUrl           String
  createdAt          DateTime            @default(now())
  courseEvents       CourseEvent[]
  Grade              Grade[]
  lessons            Lesson[]
  Notification       Notification[]
  quizzes            Quiz[]
  submissions        Submission[]
  tests              Test[]
  timeAccommodations TimeAccommodation[]
  practiceSets       PracticeSet[]
  // enumitem-style label template per lesson nesting level, e.g.
  // ["\arabic*", "\arabic{enumi}.\arabic*"]. Empty = the default
  // scheme. See src/lib/enum-labels.ts.
  lessonLabelScheme  String[]            @default([])

  /// Curriculum tagging (#216, contracts/curriculum.md): the topic list the
  /// course's lessons and questions are tagged from. Null = not set.
  curriculum Curriculum?
  /// Catalogue subject key, e.g. "mathematics" (src/features/courses/lib/curriculum.ts).
  subject    String?
  gradeLevel Int?

  // Tenancy (Agent A, design 01; added in A's tenancy part 2 with the
  // owner's go-ahead, for B to review). Nullable until a later migration
  // makes them required. Teaching is CourseStaff and enrolment is
  // Enrollment; `tutorId` and the implicit join were dropped in
  // 10_drop_legacy_course_links (issue #93, step 5).
  workspaceId       String?
  teamId            String?
  ownerMembershipId String?
  workspace         Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  team              Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ownerMembership   Membership?   @relation("CourseOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  staff             CourseStaff[]
  enrollments       Enrollment[]

  // Billing back-relations only (Agent A, billing.prisma, Phase 2). No
  // columns on Course; noted for B's review in a/HANDOFF.md.
  services     CourseService[]
  tierHolds    CourseTierHold[]
  tierOverride CourseTierOverride?
  feeSchedules FeeSchedule[]

  // Join requests back-relations only (Agent A, tenancy.prisma, #206).
  listing      CourseListing?
  joinRequests JoinRequest[]

  riskAlerts RiskAlert[]

  bookings Booking[]

  @@index([workspaceId])
}

model Lesson {
  id              String             @id @default(cuid())
  title           String
  description     String?
  /// Rich-text body: {schemaVersion, doc} from src/lib/content. `description`
  /// keeps the markdown derived from it, for search, email and old readers.
  descriptionJson Json?
  order           Int
  courseId        String
  createdAt       DateTime           @default(now())
  duration        Int?
  videoUrl        String[]           @default([])
  /// Curriculum topic codes, e.g. "caps:mathematics:10:functions" (contracts/curriculum.md).
  topics          String[]           @default([])
  attachmentUrls  Attachment[]
  course          Course             @relation(fields: [courseId], references: [id])
  completions     LessonCompletion[]

  // Lesson groups. A lesson may sit under a parent lesson; `order` is the
  // position among its siblings. NONE lessons are content-free headings
  // that only group their children (mirrors QuestionType.NONE).
  type     LessonType @default(CONTENT)
  parentId String?
  parent   Lesson?    @relation("LessonGroups", fields: [parentId], references: [id], onDelete: SetNull)
  children Lesson[]   @relation("LessonGroups")
}

enum Curriculum {
  CAPS
  IEB
  OTHER
}

enum LessonType {
  CONTENT
  NONE
}

model Attachment {
  id       String @id @default(cuid())
  title    String
  url      String
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonCompletion {
  id          String   @id @default(cuid())
  studentId   String
  lessonId    String
  completedAt DateTime
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  description String
  url         String
  uploadedAt  DateTime @default(now())
  uploadedBy  String
}

model Quiz {
  id          String                 @id @default(cuid())
  title       String
  courseId    String
  dueDate     DateTime
  maxAttempts Int?
  createdAt   DateTime               @default(now())
  completions AssessmentCompletion[]
  course      Course                 @relation(fields: [courseId], references: [id])
}

model UploadedFile {
  id           String         @id @default(cuid())
  fileUrl      String
  fileType     FileType
  questionId   String
  submissionId String
  question     TestQuestion   @relation(fields: [questionId], references: [id])
  submission   TestSubmission @relation(fields: [submissionId], references: [id])
}

enum FileType {
  PDF
  DOCX
  ZIP
  JPEG
  OTHER
}
