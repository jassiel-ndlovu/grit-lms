// messaging.prisma — owned by Agent A (docs/revamp/AGENTS.md, section 2).
// Part of the multi-file schema in prisma/schema/. Edit only the files your agent owns.

model Notification {
  id            String               @id @default(cuid())
  title         String
  message       String
  link          String?
  type          NotificationType
  priority      NotificationPriority @default(NORMAL)
  isRead        Boolean              @default(false)
  createdAt     DateTime             @default(now())
  readAt        DateTime?
  studentId     String?
  courseId      String?
  // The recipient. Every notification emitted since per-user preferences
  // landed has one row per recipient with userId set; older rows have it
  // null and are matched by studentId / courseId instead.
  userId        String?
  // When this row went out by email (immediately or in a digest).
  emailedAt     DateTime?
  // The sender chose in-app only (e.g. a tutor unticking "email the
  // student" when grading); never emailed, not even in a digest.
  suppressEmail Boolean              @default(false)

  course  Course?  @relation(fields: [courseId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationType {
  COURSE_UPDATE
  LESSON_CREATED
  TEST_CREATED
  TEST_DELETED
  TEST_UPDATED
  QUIZ_CREATED
  SUBMISSION_CREATED
  SUBMISSION_DUE
  SUBMISSION_UPDATED
  SUBMISSION_DELETED
  SUBMISSION_GRADED
  TEST_DUE
  TEST_GRADED
  MESSAGE
  SYSTEM
  LESSON_UPDATED
  LESSON_DELETED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  // Sent to the tutor when a student hands in work, and to the student as
  // a receipt.
  TEST_SUBMITTED
  SUBMISSION_RECEIVED
  STUDY_REMINDER
  GRADING_REMINDER
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// Send queue for transactional email (design 05, section 6). One row per
// email; idempotencyKey makes "send once" hold even after Resend's own
// 24-hour key expires. No relations: rows outlive users and workspaces.
model OutboundEmail {
  id                String                @id @default(cuid())
  /// e.g. billing:dunning-day-3:<invoiceId>:<userId>. Also Resend's Idempotency-Key.
  idempotencyKey    String                @unique @db.VarChar(256)
  userId            String?
  toEmail           String
  workspaceId       String?
  template          String
  category          String
  priority          OutboundEmailPriority @default(NORMAL)
  /// Template input; rendered at send time. No secrets.
  data              Json
  status            OutboundEmailStatus   @default(QUEUED)
  attempts          Int                   @default(0)
  nextAttemptAt     DateTime              @default(now())
  lockedUntil       DateTime?
  lastError         String?
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())

  @@index([status, priority, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

enum OutboundEmailPriority {
  AUTH
  BILLING
  NORMAL
  DIGEST
}

enum OutboundEmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SUPPRESSED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

/// An enquiry to Nexa itself from the public landing page (#216). Not a
/// workspace's own enquiry pipeline. Kept 12 months (housekeeping), then deleted.
model PlatformEnquiry {
  id           String        @id @default(cuid())
  /// ACCESS (a tutor or school wanting an account), TEAM (an organisation), OTHER.
  kind         String        @db.VarChar(16)
  name         String        @db.VarChar(120)
  email        String        @db.VarChar(254)
  phone        String?       @db.VarChar(40)
  organisation String?       @db.VarChar(160)
  /// The number of students, as given.
  students     Int?
  message      String        @db.VarChar(4000)
  /// The page or campaign it came from (a same-site path, or a utm_source).
  source       String?       @db.VarChar(120)
  status       EnquiryStatus @default(NEW)
  note         String?       @db.VarChar(2000)
  /// sha256 of the IP with a server secret, for rate limits only.
  ipHash       String        @db.VarChar(64)
  createdAt    DateTime      @default(now())
  handledAt    DateTime?

  @@index([ipHash, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
}

// At-risk alerts (#216 phase 2, Pro; A). Rules: src/features/risk/rules.ts.

enum RiskLevel {
  WATCH
  AT_RISK
}

enum RiskAlertStatus {
  OPEN
  SHARED
  RESOLVED
  DISMISSED
}

/// One student in one course who the daily job flagged. Open while OPEN or
/// SHARED (openKey set, one per course and student); RESOLVED when the
/// rules stop firing or staff close it; DISMISSED keeps quiet until quietUntil.
model RiskAlert {
  id             String          @id @default(cuid())
  workspaceId    String
  courseId       String
  /// The student's User id.
  studentUserId  String
  level          RiskLevel
  status         RiskAlertStatus @default(OPEN)
  /// RiskReason[] from the rules, as last evaluated.
  reasons        Json
  /// The plain-language summary, as last evaluated.
  summary        String          @db.VarChar(2000)
  /// "<courseId>:<studentUserId>" while open; null once closed.
  openKey        String?         @unique
  firstSeenAt    DateTime        @default(now())
  lastSeenAt     DateTime        @default(now())
  sharedAt       DateTime?
  sharedByUserId String?
  /// GUARDIANS and/or STUDENT.
  sharedWith     String[]        @default([])
  /// The staff member's note, sent with the summary.
  shareNote      String?         @db.VarChar(1000)
  /// What was sent: the summary when shared.
  sharedSummary  String?         @db.VarChar(2000)
  closedAt       DateTime?
  /// Null when the job closed it because the rules stopped firing.
  closedByUserId String?
  quietUntil     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([courseId, status])
  @@index([studentUserId, status])
}

// The course study assistant (#216 phase 3, Pro; A). Chats are visible to the course's tutors.

/// One student's conversation with a course's study assistant.
model StudyChat {
  id            String    @id @default(cuid())
  workspaceId   String
  courseId      String
  studentUserId String
  title         String    @db.VarChar(120)
  /// Set when a message raised a wellbeing or safety concern; tutors see it first.
  flaggedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages  StudyMessage[]

  @@index([courseId, updatedAt])
  @@index([studentUserId, updatedAt])
}

model StudyMessage {
  id         String   @id @default(cuid())
  chatId     String
  /// USER or ASSISTANT
  role       String   @db.VarChar(10)
  content    String   @db.VarChar(8000)
  /// [{ ref, lessonId, title }] for an answer.
  citations  Json?
  outOfScope Boolean  @default(false)
  /// none, wellbeing, safety, integrity
  concern    String   @default("none") @db.VarChar(12)
  credits    Int      @default(0)
  createdAt  DateTime @default(now())

  chat StudyChat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

// Help and contact centre (owner 24 Nov; A). Contract: docs/revamp/contracts/support.md.

enum SupportKind {
  QUESTION
  PROBLEM
  FEEDBACK
}

enum SupportTopic {
  ACCOUNT
  CLASSES
  TESTS
  PAYMENTS
  SUBSCRIPTION
  APP
  OTHER
}

/// Who answers: Nexa's team, or the requester's organisation.
enum SupportRoute {
  NEXA
  WORKSPACE
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportQuery {
  id               String        @id @default(cuid())
  /// Shown as Q-<number>.
  number           Int           @unique @default(autoincrement())
  kind             SupportKind
  topic            SupportTopic
  route            SupportRoute
  /// Set when route is WORKSPACE (and kept for context otherwise, if known).
  workspaceId      String?
  /// The course it's about, if any (no foreign key: learning is B's schema).
  courseId         String?
  /// Signed-in requester; null for the public form (then name and email are given).
  requesterUserId  String?
  requesterName    String        @db.VarChar(120)
  requesterEmail   String        @db.VarChar(254)
  /// learner, guardian, staff, admin or public, when it was sent.
  requesterPersona String        @db.VarChar(16)
  subject          String        @db.VarChar(140)
  status           SupportStatus @default(OPEN)
  /// The page they came from (same-site path).
  pagePath         String?       @db.VarChar(300)
  userAgent        String?       @db.VarChar(300)
  /// The requester's verdict on the answer.
  helpful          Boolean?
  /// Public form: a keyed hash of the IP for rate limits; a random token for the private link.
  ipHash           String?       @db.VarChar(64)
  accessToken      String?       @unique @db.VarChar(64)
  /// The requester has read up to here; staff have read up to here.
  requesterReadAt  DateTime?
  staffReadAt      DateTime?
  createdAt        DateTime      @default(now())
  lastActivityAt   DateTime      @default(now())
  closedAt         DateTime?

  workspace Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requester User?            @relation("SupportRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([requesterUserId, lastActivityAt])
  @@index([route, status, lastActivityAt])
  @@index([workspaceId, status, lastActivityAt])
  @@index([courseId])
  @@index([ipHash, createdAt])
  @@index([requesterEmail, createdAt])
}

model SupportMessage {
  id           String   @id @default(cuid())
  queryId      String
  /// Null for the public requester (and for a deleted account).
  authorUserId String?
  authorName   String   @db.VarChar(120)
  /// True when written by whoever answers (organisation staff or Nexa).
  fromStaff    Boolean
  /// Staff-only note; never shown to the requester.
  internal     Boolean  @default(false)
  body         String   @db.VarChar(5000)
  /// Blob URLs of up to 3 images.
  attachments  String[] @default([])
  createdAt    DateTime @default(now())

  query  SupportQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  author User?        @relation("SupportAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([queryId, createdAt])
}
